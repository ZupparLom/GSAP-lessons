
Установка напоминания куки через обычный див с анимацияе появления

<script>
document.addEventListener("DOMContentLoaded", () => {
  //  Вспомогательные функции для работы с cookie
  const cookies = {
    get: (name) => {
      const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? decodeURIComponent(match[2]) : undefined;
    },
    set: (name, value, options = {}) => {
      options = {
        path: '/',
        ...options
      };

      if (options.expires) {
        const date = new Date();
        date.setTime(date.getTime() + options.expires * 24 * 60 * 60 * 1000); // 🕒 expires = дни → миллисекунды
        options.expires = date.toUTCString();
      }

      let updatedCookie = encodeURIComponent(name) + "=" + encodeURIComponent(value);

      for (const [key, val] of Object.entries(options)) {
        updatedCookie += '; ' + key;
        if (val !== true) {
          updatedCookie += '=' + val;
        }
      }

      document.cookie = updatedCookie;
    }
  };

  // Ссылки на элементы интерфейса
  const ui = {
    banner: document.querySelector(".modal-cook"),
    content: document.querySelector(".cook-content"),
    consentBtn: document.querySelector(".button-cookie"),
    rejectBtn: document.querySelector(".button-no-cookie")
  };

  // Скрыть баннер (по таймеру или нажатию)
  const hideBanner = () => {
    if (ui.banner) ui.banner.style.display = "none";
  };

  // Показать баннер с анимацией
  const showBanner = () => {
    if (ui.banner && ui.content) {
      ui.banner.style.display = "flex";

      // Начальная анимация (невидимость и движение)
      ui.content.style.transition = "none";
      ui.content.style.opacity = "0";
      ui.content.style.transform = "translateY(4vh)";
      void ui.content.offsetWidth;

      // Анимация появления (через 1.2s, длится 0.5s, ease)
      ui.content.style.transition = "opacity 0.5s ease 1.2s, transform 0.5s ease 1.2s";
      requestAnimationFrame(() => {
        ui.content.style.opacity = "1";
        ui.content.style.transform = "translateY(0)";
      });
    }
  };

  // Проверка: есть ли уже cookieAgreement?
  const cookieStatus = cookies.get("cookieAgreement");

  if (cookieStatus === undefined) {
    // Cookie НЕТ — показываем баннер
    showBanner();
  } else {
    // Cookie УЖЕ ЕСТЬ — скрываем баннер на весь срок действия cookie
    hideBanner();
  }

  // Согласие на cookies
  ui.consentBtn?.addEventListener("click", () => {
    cookies.set("cookieAgreement", "true", { expires: 7 }); // срок действия — 7 дней
    hideBanner();
  });

  // Отказ от cookies
  ui.rejectBtn?.addEventListener("click", () => {
    cookies.set("cookieAgreement", "false", { expires: 7 }); // тоже скрываем на 7 дней
    hideBanner();
  });
});
</script>

