С разделением анимации по слаг страниц. В данном случае Главная и med-odezhda (слаг) 

<!-- Куки -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  // Вспомогательные функции для работы с cookie
  const cookies = {
    get: (name) => {
      const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? decodeURIComponent(match[2]) : undefined;
    },
    set: (name, value, options = {}) => {
      options = {
        path: '/',
        ...options
      };

      if (options.expires) {
        const date = new Date();
        date.setTime(date.getTime() + options.expires * 24 * 60 * 60 * 1000);
        options.expires = date.toUTCString();
      }

      let updatedCookie = encodeURIComponent(name) + "=" + encodeURIComponent(value);

      for (const [key, val] of Object.entries(options)) {
        updatedCookie += '; ' + key;
        if (val !== true) {
          updatedCookie += '=' + val;
        }
      }

      document.cookie = updatedCookie;
    }
  };

  // Ссылки на элементы интерфейса
  const ui = {
    banner: document.querySelector(".popup-cookies"),
    content: document.querySelector(".popup-cookie-content"),
    consentBtn: document.querySelector(".btn-cookie"),
    rejectBtn: document.querySelector(".button-no-cookie")
  };

  // Скрыть баннер
  const hideBanner = () => {
    if (ui.banner) ui.banner.style.display = "none";
  };

  // Показать баннер с анимацией для обертки
  const showBanner = () => {
    if (ui.banner) {
      // Показываем баннер
      ui.banner.style.display = "flex";
      
      // Устанавливаем начальные стили (без анимации)
      ui.banner.style.transition = "none";
      ui.banner.style.opacity = "0";
      ui.banner.style.transform = "translateY(4vh)";
      
      // Форсируем перерисовку
      void ui.banner.offsetWidth;
      
      // Определение текущей страницы и времени задержки
      const currentPath = window.location.pathname;
      const delay = currentPath.includes("med-odezhda") ? "0.2s" : "2.8s";
      
      // Добавляем transition и запускаем анимацию в следующем кадре
      ui.banner.style.transition = `opacity 0.6s ease ${delay}, transform 0.6s ease ${delay}`;
      
      requestAnimationFrame(() => {
        ui.banner.style.opacity = "1";
        ui.banner.style.transform = "translateY(0)";
      });
    }
  };

  // Проверка наличия cookie
  const cookieStatus = cookies.get("cookieAgreement");

  if (cookieStatus === undefined) {
    // Cookie нет - показываем баннер с анимацией
    showBanner();
  } else {
    // Cookie есть - скрываем баннер
    hideBanner();
  }

  // Обработчики событий
  ui.consentBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    cookies.set("cookieAgreement", "true", { expires: 7 });
    hideBanner();
  });

  ui.rejectBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    cookies.set("cookieAgreement", "false", { expires: 7 });
    hideBanner();
  });
});
</script>


