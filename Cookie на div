
Установка напоминания куки через обычный див с анимацияе появления

<!-- Cookie -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  // ==========================================
  // НАСТРОЙКИ СКРИПТА
  // ==========================================
  const CONFIG = {
    // Настройки Cookie
    cookieName: "cookieAgreement", // Имя создаваемого cookie
    cookieExpireDays: 7,           // Срок жизни cookie в днях
    cookiePath: "/",               // Путь для cookie (работает на всех страницах)
    
    // Селекторы элементов интерфейса
    bannerSelector: ".modal-cook",    // Класс модального окна/баннера
    contentSelector: ".cook-content", // Класс контента для анимации
    btnConsentSelector: ".btn-cook",  // Кнопка принятия
    btnRejectSelector: ".btn-no-cook",// Кнопка отказа
    
    // Настройки анимации (зависят от изначальных CSS стилей Taptop)
    animationDelay: "3.6s",           // Задержка перед появлением
    animationDuration: "0.8s"         // Длительность анимации появления
  };

  // ==========================================
  // ФУНКЦИИ РАБОТЫ С COOKIE (Адаптировано для Safari/iOS)
  // ==========================================
  const cookies = {
    get: (name) => {
      // Более надежное регулярное выражение для поиска конкретного cookie
      const matches = document.cookie.match(new RegExp(
        "(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, '\\$1') + "=([^;]*)"
      ));
      return matches ? decodeURIComponent(matches[1]) : undefined;
    },
    set: (name, value, days) => {
      let expires = "";
      let maxAge = "";
      
      if (days) {
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        expires = "; expires=" + date.toUTCString();
        // Safari на iOS лучше воспринимает max-age для установки срока жизни
        maxAge = "; max-age=" + (days * 24 * 60 * 60); 
      }
      
      // Добавлен SameSite=Lax для предотвращения блокировки браузерами (в т.ч. Safari ITP)
      document.cookie = name + "=" + encodeURIComponent(value) + expires + maxAge + "; path=" + CONFIG.cookiePath + "; SameSite=Lax";
    }
  };

  // ==========================================
  // ЛОГИКА РАБОТЫ ИНТЕРФЕЙСА
  // ==========================================
  
  // Получаем элементы DOM
  const banner = document.querySelector(CONFIG.bannerSelector);
  const content = document.querySelector(CONFIG.contentSelector);
  const consentBtn = document.querySelector(CONFIG.btnConsentSelector);
  const rejectBtn = document.querySelector(CONFIG.btnRejectSelector);

  // Если баннер отсутствует на странице, прерываем скрипт
  if (!banner) return;

  // Скрытие баннера
  const hideBanner = () => {
    banner.style.display = "none";
  };

  // Показ баннера с анимацией
  const showBanner = () => {
    banner.style.display = "flex";
    
    if (content) {
      // Сброс стилей перед анимацией
      content.style.transition = "none";
      content.style.opacity = "0";
      content.style.transform = "translateY(5vh)";
      
      // Принудительный reflow (необходимо для iOS и Safari, чтобы анимация сработала корректно)
      void content.offsetWidth;
      
      // Назначение анимации
      content.style.transition = `opacity ${CONFIG.animationDuration} ease ${CONFIG.animationDelay}, transform ${CONFIG.animationDuration} ease ${CONFIG.animationDelay}`;
      
      // Использование setTimeout вместо requestAnimationFrame стабильнее работает в Safari
      setTimeout(() => {
        content.style.opacity = "1";
        content.style.transform = "translateY(0)";
      }, 50);
    }
  };

  // ==========================================
  // ИНИЦИАЛИЗАЦИЯ И ОБРАБОТЧИКИ
  // ==========================================
  
  const cookieStatus = cookies.get(CONFIG.cookieName);

  if (cookieStatus === undefined) {
    showBanner();
  } else {
    hideBanner();
  }

  // Нажатие на кнопку принятия
  if (consentBtn) {
    consentBtn.addEventListener("click", () => {
      cookies.set(CONFIG.cookieName, "true", CONFIG.cookieExpireDays);
      hideBanner();
    });
  }

  // Нажатие на кнопку отказа
  if (rejectBtn) {
    rejectBtn.addEventListener("click", () => {
      cookies.set(CONFIG.cookieName, "false", CONFIG.cookieExpireDays);
      hideBanner();
    });
  }
});
</script>
