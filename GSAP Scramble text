при наведении на любой .menu-link, '.btn-white', '.menu-open_link', '.btn-black' анимация будет запускаться на его внутреннем элементе .scramble. С ограничением на рахрешение ниже 992
<!-- GSAP + ScrambleTextPlugin -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js   "></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrambleTextPlugin.min.js   "></script>



<script>
  // РЕГИСТРАЦИЯ ПЛАГИНОВ
  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin, SplitText);

  // ============================================
  // 1) HOVER SCRAMBLE-TEXT ANIMATION (ПК > 991px)
  // ============================================
  document.fonts.ready.then(() => {
    const parentSelectors = ['.menu-link', '.btn-white', '.menu-open_link', '.btn-black', '.cover-link'];
    const isDesktop = window.innerWidth > 991;
    const isMotionEnabled = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    if (!isDesktop || !isMotionEnabled) return;

    document.querySelectorAll('.scramble-hover').forEach(el => {
      const split = new SplitText(el, { type: 'chars, words' });
      const chars = split.chars;
      const original = chars.map(ch => ch.textContent);

      // Параметры анимации (hover)
      const baseDelay     = 0.05;
      const delayStep     = 0.05;
      const duration      = 0.4;
      const scrambleChars = '0123456789';
      const revealDelay   = 0.4;

      function animateHover() {
        gsap.killTweensOf(chars);
        chars.forEach((ch, i) => {
          ch.textContent = original[i];
          gsap.set(ch, { autoAlpha: 0 });
        });
        chars.forEach((ch, i) => {
          if (!original[i].trim()) return;
          gsap.fromTo(ch,
            { autoAlpha: 1 },
            {
              autoAlpha: 1,
              scrambleText: { text: original[i], chars: scrambleChars, revealDelay: revealDelay, tweenLength: false, preserveSpaces: true },
              duration: duration,
              delay: baseDelay + i * delayStep,
              ease: 'sine.in',
              onComplete: () => ch.textContent = original[i]
            }
          );
        });
      }

      parentSelectors.forEach(selector => {
        const parent = el.closest(selector);
        if (parent) parent.addEventListener('mouseenter', animateHover);
      });
    });
  });

</script>
