При наведении на любой элементы .scramble-hover или '.scramble-btn' (количество элементов можно увеличить) анимация будет запускаться на его внутреннем элементе .scramble. 
Работает только на пк версии (мин. ширина экрана 992рх).

<!-- Подключить GSAP + ScrambleTextPlugin -->
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/ScrambleTextPlugin.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/SplitText.min.js"></script>


<script>
  // РЕГИСТРАЦИЯ ПЛАГИНОВ
  gsap.registerPlugin(ScrambleTextPlugin, SplitText);

  // HOVER SCRAMBLE-TEXT ANIMATION (ПК > 991px)
  document.fonts.ready.then(() => {
    const parentSelectors = ['.scramble-hover', '.scramble-btn'];
    const isDesktop = window.innerWidth > 991;
    const isMotionEnabled = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    if (!isDesktop || !isMotionEnabled) return;

    document.querySelectorAll('.scramble').forEach(el => {
      const split = new SplitText(el, { type: 'chars, words' });
      const chars = split.chars;
      const original = chars.map(ch => ch.textContent);

      // Параметры анимации (hover)
      const baseDelay     = 0.05; // Начальная задержка перед стартом анимации для самого первого символа
      const delayStep     = 0.05; // Дополнительное время, которое прибавляется к задержке каждого следующего символа
      const duration      = 0.4; // Общая длительность анимации (перебора символов) для каждого отдельного символа
      const scrambleChars = '0123456789'; // Символы под замену. Можно заменить на любые другие символы, например '!@#$%^&*' или буквы алфавита
      const revealDelay   = 0.4; // Время, в течение которого плагин будет показывать только хаотичные символы

      function animateHover() {
        gsap.killTweensOf(chars);
        chars.forEach((ch, i) => {
          ch.textContent = original[i];
          gsap.set(ch, { autoAlpha: 0 });
        });
        chars.forEach((ch, i) => {
          if (!original[i].trim()) return;
          gsap.fromTo(ch,
            { autoAlpha: 1 },
            {
              autoAlpha: 1,
              scrambleText: { text: original[i], chars: scrambleChars, revealDelay: revealDelay, tweenLength: false, preserveSpaces: true },
              duration: duration,
              delay: baseDelay + i * delayStep,
              ease: 'sine.in', //изинг можно менять
              onComplete: () => ch.textContent = original[i]
            }
          );
        });
      }

      parentSelectors.forEach(selector => {
        const parent = el.closest(selector);
        if (parent) parent.addEventListener('mouseenter', animateHover);
      });
    });
  });

</script>
