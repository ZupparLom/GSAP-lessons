<!-- Убрали прямую ссылку на скрипт! Он загрузится только когда будет нужно / добавили паузу при клике-->
<script>
  // 1. Очищаем iframe и добавляем ленивую загрузку
  document.addEventListener('DOMContentLoaded', function() {
    const allIframes = document.querySelectorAll('.video_slider_item iframe');
    allIframes.forEach(iframe => {
      iframe.setAttribute('loading', 'lazy');
      if (iframe.src) {
        iframe.removeAttribute('src'); 
      }
    });
  });

  // Флаг загрузки скрипта
  let kinescopeApiLoaded = false;
  function loadKinescopeScript(callback) {
    if (kinescopeApiLoaded) {
      if (callback) callback();
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://player.kinescope.io/latest/iframe.player.js';
    script.async = true;
    script.onload = function() {
      kinescopeApiLoaded = true;
      if (callback) callback();
    };
    document.body.appendChild(script);
  }

  // Обсервер для паузы при свайпе или скролле
  const slideObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) {
        const slide = entry.target;
        const iframe = slide.querySelector('iframe');
        const playBtn = slide.querySelector('.btn-play');
        
        if (playBtn) {
          playBtn.classList.remove('hidden');
        }

        if (iframe && iframe.kPlayer) {
          iframe.kPlayer.pause().catch(() => {});
        }
      }
    });
  }, { threshold: 0.1 });


  // 2. ЕДИНЫЙ ОБРАБОТЧИК КЛИКОВ (для запуска и для паузы)
  document.addEventListener('click', function(e) {
    // Находим слайд, по которому кликнули
    const slide = e.target.closest('.video_slider_item');
    if (!slide) return;

    const iframe = slide.querySelector('iframe');
    const playBtn = slide.querySelector('.btn-play');
    if (!iframe || !playBtn) return;

    // --- ЛОГИКА ПАУЗЫ ПО КЛИКУ НА ВИДЕО ---
    // Если клик был НЕ по кнопке Play, проверяем: играет ли видео сейчас?
    const isClickOnBtn = e.target.closest('.btn-play');
    
    if (!isClickOnBtn) {
      // Если кнопка скрыта (значит видео играет) и у iframe есть плеер
      if (playBtn.classList.contains('hidden') && iframe.kPlayer) {
        e.preventDefault();
        e.stopPropagation();
        
        // Ставим на паузу и возвращаем кнопку
        iframe.kPlayer.pause().catch(() => {});
        playBtn.classList.remove('hidden');
      }
      return; // Завершаем функцию, так как это была команда паузы
    }

    // --- ЛОГИКА ЗАПУСКА (если клик был именно по кнопке .btn-play) ---
    e.preventDefault();
    e.stopPropagation();

    playBtn.classList.add('hidden'); 
    slideObserver.observe(slide);

    const videoId = iframe.getAttribute('data-video-id');
    const videoUrl = 'https://kinescope.io/embed/' + videoId;

    if (!iframe.id) {
      iframe.id = 'kinescope-player-' + Math.random().toString(36).substr(2, 9);
    }

    loadKinescopeScript(function() {
      if (window.Kinescope && window.Kinescope.IframePlayer) {
        
        if (iframe.kPlayer) {
          iframe.kPlayer.play().catch(err => console.error(err));
          return;
        }

        window.Kinescope.IframePlayer.create(iframe.id, {
          url: videoUrl,
          ui: { controls: false, mainPlayButton: false }
        }).then(function(player) {
          iframe.kPlayer = player;
          
          player.play().catch(function(err) {
            console.error('Автоплей заблокирован:', err);
            playBtn.classList.remove('hidden'); 
          });

          player.on('pause', () => playBtn.classList.remove('hidden'));
          player.on('ended', () => playBtn.classList.remove('hidden'));

        }).catch(err => {
          console.error('Ошибка инициализации Kinescope:', err);
          playBtn.classList.remove('hidden');
        });
      }
    });
  });
</script>
