<!-- Стили для видео и кнопки play -->
<style>

/* 1. Стили для видео (уводим его на задний план) */
.video-link iframe {
  position: absolute !important;
  width: 100% !important;
  height: 100% !important;
  left: 0;
  top: 0;
  object-fit: cover;
  pointer-events: none !important; /* Пропускаем клики */
}

/* 2. Жестко поднимаем вашу кнопку из Taptop наверх */
.btn-play {
  z-index: 100 !important; /* Гарантирует, что кнопка перехватит клик первой */
  opacity: 1;
  pointer-events: auto !important; /* Убеждаемся, что клик по кнопке сработает */
}

/* 3. Класс для скрытия кнопки во время воспроизведения */
.btn-play.hidden {
  opacity: 0 !important;
  pointer-events: none !important;
}

</style>

<!-- Подключаем API Kinescope -->
<script src="https://player.kinescope.io/latest/iframe.player.js"></script>

<script>
  // 1. ОПТИМИЗАЦИЯ: Очищаем iframe сразу при загрузке страницы, 
  // чтобы они не тормозили сайт (если Taptop отрендерил их с src)
  document.addEventListener('DOMContentLoaded', function() {
    const allIframes = document.querySelectorAll('.video_slider_item iframe');
    allIframes.forEach(iframe => {
      if (iframe.src) {
        // Убираем src, чтобы остановить предзагрузку плееров
        iframe.removeAttribute('src'); 
      }
    });
  });

  // 2. Основная логика: загрузка только по клику
  document.addEventListener('click', function(e) {
    const playBtn = e.target.closest('.btn-play');
    if (!playBtn) return; 

    e.preventDefault();
    e.stopPropagation();

    const slide = playBtn.closest('.video_slider_item');
    if (!slide) return;

    const iframe = slide.querySelector('iframe');
    if (!iframe) return;

    // Сразу прячем кнопку (и показываем индикатор загрузки, если нужно)
    playBtn.classList.add('hidden');

    const videoId = iframe.getAttribute('data-video-id');
    const videoUrl = 'https://kinescope.io/embed/' + videoId;

    // Генерируем ID для iframe
    if (!iframe.id) {
      iframe.id = 'kinescope-player-' + Math.random().toString(36).substr(2, 9);
    }

    if (window.Kinescope && window.Kinescope.IframePlayer) {
      
      // Если мы уже создали плеер для этого видео (повторный клик)
      if (iframe.kPlayer) {
        iframe.kPlayer.play().catch(function(err) { console.error('Ошибка:', err); });
        return;
      }

      // СОЗДАЕМ ПЛЕЕР И ЗАГРУЖАЕМ ЕГО ТОЛЬКО СЕЙЧАС
      window.Kinescope.IframePlayer.create(iframe.id, {
        url: videoUrl,
        ui: {
          controls: false,
          mainPlayButton: false
        }
      }).then(function(player) {
        iframe.kPlayer = player;
        
        // Как только плеер создался, даем команду играть
        player.play().catch(function(err) {
          console.error('Браузер заблокировал запуск:', err);
          playBtn.classList.remove('hidden'); 
        });

        // Возвращаем кнопку на паузе или в конце
        player.on('pause', function() { playBtn.classList.remove('hidden'); });
        player.on('ended', function() { playBtn.classList.remove('hidden'); });

      }).catch(function(err) {
        console.error('Ошибка инициализации Kinescope:', err);
        playBtn.classList.remove('hidden');
      });
      
    } else {
      console.warn('Библиотека Kinescope еще не загрузилась');
      playBtn.classList.remove('hidden');
    }
  });
</script>

========================================================================================================
Закгрузка ролика чуть медленее
<!-- Убрали прямую ссылку на скрипт! Он загрузится только когда будет нужно -->
<script>
  // 1. Очищаем iframe и добавляем ленивую загрузку СРАЗУ, до рендера страницы
  document.addEventListener('DOMContentLoaded', function() {
    const allIframes = document.querySelectorAll('.video_slider_item iframe');
    allIframes.forEach(iframe => {
      // Говорим мобильному браузеру: "не трогай это, пока не увидишь"
      iframe.setAttribute('loading', 'lazy');
      
      if (iframe.src) {
        iframe.removeAttribute('src'); 
      }
    });
  });

  // Переменная-флаг для отслеживания загрузки скрипта Kinescope
  let kinescopeApiLoaded = false;

  // Функция, которая динамически скачивает библиотеку Kinescope только по необходимости
  function loadKinescopeScript(callback) {
    if (kinescopeApiLoaded) {
      if (callback) callback();
      return;
    }
    
    const script = document.createElement('script');
    script.src = 'https://player.kinescope.io/latest/iframe.player.js';
    script.async = true;
    script.onload = function() {
      kinescopeApiLoaded = true;
      if (callback) callback();
    };
    document.body.appendChild(script);
  }

  // 2. Логика по клику
  document.addEventListener('click', function(e) {
    const playBtn = e.target.closest('.btn-play');
    if (!playBtn) return; 

    e.preventDefault();
    e.stopPropagation();

    const slide = playBtn.closest('.video_slider_item');
    if (!slide) return;

    const iframe = slide.querySelector('iframe');
    if (!iframe) return;

    // Прячем кнопку, можно тут добавить класс с лоадером-крутилкой
    playBtn.classList.add('hidden'); 

    const videoId = iframe.getAttribute('data-video-id');
    const videoUrl = 'https://kinescope.io/embed/' + videoId;

    if (!iframe.id) {
      iframe.id = 'kinescope-player-' + Math.random().toString(36).substr(2, 9);
    }

    // Загружаем скрипт Kinescope ТОЛЬКО после первого клика пользователя по кнопке
    loadKinescopeScript(function() {
      
      if (window.Kinescope && window.Kinescope.IframePlayer) {
        
        if (iframe.kPlayer) {
          iframe.kPlayer.play().catch(err => console.error(err));
          return;
        }

        window.Kinescope.IframePlayer.create(iframe.id, {
          url: videoUrl,
          ui: { controls: false, mainPlayButton: false }
        }).then(function(player) {
          iframe.kPlayer = player;
          
          player.play().catch(function(err) {
            console.error('Автоплей заблокирован мобильным браузером:', err);
            // На iOS автоплей может быть заблокирован политикой Apple.
            // В этом случае возвращаем кнопку, чтобы пользователь нажал еще раз.
            playBtn.classList.remove('hidden'); 
          });

          player.on('pause', () => playBtn.classList.remove('hidden'));
          player.on('ended', () => playBtn.classList.remove('hidden'));

        }).catch(err => {
          console.error('Ошибка инициализации Kinescope:', err);
          playBtn.classList.remove('hidden');
        });
      }
    });
  });
</script>


