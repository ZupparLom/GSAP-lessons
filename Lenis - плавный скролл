<!-- LENIS SMOOTH SCROLL -->
<script src="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js"></script>

<!-- Обязательные стили для Safari и внутреннего скролла --> 
<style> 
  /* Базовые стили Lenis */ 
  html.lenis { 
    height: auto; 
  } 
 
  .lenis.lenis-smooth { 
    scroll-behavior: auto; 
  } 

  /* Настройки для внутреннего скролла попапа (исправление для Safari/iOS) */
  .popup-order__content {
    overscroll-behavior: contain; 
    -webkit-overflow-scrolling: touch; 
  }
 
  /* Стили только для десктопа (шире 992px) */ 
  @media (min-width: 993px) { 
    @supports (-webkit-touch-callout: none) { 
      html, body { 
        position: relative; /* Нужно для корректного fixed */ 
        overflow-x: hidden; 
        -webkit-overflow-scrolling: touch; 
        height: 100%; /* Safari fix */ 
      } 
 
      /* Контейнер для фиксированных элементов внутри Lenis */ 
      .lenis.lenis-smooth [data-lenis-fixed] { 
        position: fixed; 
        -webkit-transform: translateZ(0); /* аппаратное ускорение */ 
        transform: translateZ(0); 
        z-index: 1000; 
      } 
 
      /* Отдельный фикс для модальных окон */ 
      .modal, [data-fixed] { 
        position: fixed !important; 
        -webkit-backface-visibility: hidden; 
        backface-visibility: hidden; 
      } 
    } 
  } 
</style> 
 
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // --- Настройки скрипта Lenis ---
    const CONFIG = {
      // Класс контейнера, внутри которого нужно разрешить нативный скролл
      popupScrollClass: '.popup-order__content', 
      // Атрибут для отключения перехвата скролла скриптом Lenis
      preventAttr: 'data-lenis-prevent', 
      // Ширина экрана, начиная с которой работает плавный скролл
      breakpoint: 992, 
      // Настройки самого Lenis
      lerp: 0.086, 
      wheelMultiplier: 1 
    };

    // Находим все элементы с внутренним скроллом и добавляем им атрибут
    // Это позволит крутить колесо мыши внутри попапа без блокировки от Lenis
    const scrollableElements = document.querySelectorAll(CONFIG.popupScrollClass);
    scrollableElements.forEach(function(el) {
      el.setAttribute(CONFIG.preventAttr, 'true');
    });

    let lenis;
    let isScrollLocked = false;
    
    function initLenis() {
      return new Lenis({
        lerp: CONFIG.lerp,
        wheelMultiplier: CONFIG.wheelMultiplier,
        gestureOrientation: "vertical",
        normalizeWheel: false,
        smoothTouch: false,
      });
    }
    
    function checkViewportAndInit() {
      const viewportWidth = window.innerWidth;
      
      if (viewportWidth >= CONFIG.breakpoint) {
        if (!lenis) {
          lenis = initLenis();
          window.lenis = lenis; 
        }
      } else {
        if (lenis) {
          lenis.destroy();
          lenis = null;
        }
      }
    }
    
    checkViewportAndInit();
    
    window.addEventListener('resize', function() {
      checkViewportAndInit();
    });
    
    function raf(time) {
      const nowLocked = 
        document.documentElement.classList.contains("is-overflow-hidden") || 
        document.body.classList.contains("is-overflow-hidden");

      if (lenis) {
        if (nowLocked !== isScrollLocked) {
          if (nowLocked) {
            lenis.stop(); 
          } else {
            lenis.start(); 
          }
          isScrollLocked = nowLocked;
        }

        if (!isScrollLocked) {
          lenis.raf(time);
        }
      }
      
      requestAnimationFrame(raf);
    }
    
    requestAnimationFrame(raf);

    window.addEventListener('beforeunload', function() {
      if (lenis) {
        lenis.destroy();
      }
    });
  });
</script>


