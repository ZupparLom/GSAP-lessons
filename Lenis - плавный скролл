<!-- LENIS SMOOTH SCROLL -->
<script src="https://cdn.jsdelivr.net/npm/lenis@1.3.17/dist/lenis.min.js"></script>

<!-- Обязательные стили для Safari --> 
<style> 
  /* Базовые стили Lenis */ 
  html.lenis { 
    height: auto; 
  } 
 
  .lenis.lenis-smooth { 
    scroll-behavior: auto; 
  } 
 
  /* Стили только для десктопа (шире 992px) */ 
  @media (min-width: 993px) { 
    @supports (-webkit-touch-callout: none) { 
      html, body { 
        position: relative; /* Нужно для корректного fixed */ 
        overflow-x: hidden; 
        -webkit-overflow-scrolling: touch; 
        height: 100%; /* Safari fix */ 
      } 
 
      /* Контейнер для фиксированных элементов внутри Lenis */ 
      .lenis.lenis-smooth [data-lenis-fixed] { 
        position: fixed; 
        -webkit-transform: translateZ(0); /* аппаратное ускорение */ 
        transform: translateZ(0); 
        z-index: 1000; 
      } 
 
      /* Отдельный фикс для модальных окон */ 
      .modal, [data-fixed] { 
        position: fixed !important; 
        -webkit-backface-visibility: hidden; 
        backface-visibility: hidden; 
      } 
    } 
  } 
</style> 
 
<script>
  document.addEventListener("DOMContentLoaded", function () {
    let lenis;
    let isScrollLocked = false;
    
    function initLenis() {
      return new Lenis({
        lerp: 0.086,
        wheelMultiplier: 1,
        gestureOrientation: "vertical",
        normalizeWheel: false,
        smoothTouch: false,
      });
    }
    
    function checkViewportAndInit() {
      const viewportWidth = window.innerWidth;
      
      if (viewportWidth >= 992) {
        // Если Lenis еще не инициализирован и ширина экрана >= 992px
        if (!lenis) {
          lenis = initLenis();
          window.lenis = lenis; // Делаем Lenis доступным для нашего скрипта навигации
        }
      } else {
        // Если ширина экрана < 992px и Lenis активен - уничтожаем
        if (lenis) {
          lenis.destroy();
          lenis = null;
        }
      }
    }
    
    // Проверяем при загрузке
    checkViewportAndInit();
    
    // Слушаем изменение размера окна
    window.addEventListener('resize', function() {
      checkViewportAndInit();
    });
    
    function raf(time) {
      const viewportWidth = window.innerWidth;
      const nowLocked = 
        document.documentElement.classList.contains("is-overflow-hidden") || 
        document.body.classList.contains("is-overflow-hidden");

      // Обновляем состояние блокировки только если Lenis активен
      if (lenis) {
        if (nowLocked !== isScrollLocked && lenis) {
  if (nowLocked) {
    lenis.stop(); // просто останавливаем
  } else {
    lenis.start(); // продолжаем
  }
  isScrollLocked = nowLocked;
}

        if (!isScrollLocked && lenis) {
          lenis.raf(time);
        }
      }
      
      requestAnimationFrame(raf);
    }
    
    requestAnimationFrame(raf);

    // Очистка при размонтировании
    window.addEventListener('beforeunload', () => {
      if (lenis) {
        lenis.destroy();
      }
    });
  });
</script>


