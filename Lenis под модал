<script>
  document.addEventListener("DOMContentLoaded", function () {
        const media992 = window.matchMedia("(min-width: 992px)")

    if (media992.matches) {
    class AdvancedSmoothScroll {
      constructor(options = {}) {
        this.options = {
          // Основные настройки (максимально близко к нативному скроллу)
          damping: 0.1, // Оптимальное значение для естественности
          wheelMultiplier: 1.0, // Без умножения - точное соответствие колесу
          touchMultiplier: 1.0, // Точное соответствие касаниям

          // Минимальная дистанция затухания
          stopDistance: 0.5, // Почти мгновенная остановка
          maxDistance: 10000,

          // Дополнительные настройки для естественности
          checkOverflowHidden: true,
          enableMomentum: true, // Легкая инерция как в браузере
          momentumFactor: 0.02, // Минимальная инерция

          ...options,
        }

        this.scroll = {
          current: 0,
          target: 0,
          limit: 0,
        }

        this.isScrolling = false
        this.rafId = null
        this.isEnabled = true
        this.observer = null

        this.init()
      }

      init() {
        this.updateScrollLimit()

        this.onWheel = this.onWheel.bind(this)
        this.onTouchStart = this.onTouchStart.bind(this)
        this.onTouchMove = this.onTouchMove.bind(this)
        this.onResize = this.onResize.bind(this)
        this.animate = this.animate.bind(this)
        this.checkOverflowState = this.checkOverflowState.bind(this)

        window.addEventListener("wheel", this.onWheel, { passive: false })
        window.addEventListener("touchstart", this.onTouchStart, { passive: false })
        window.addEventListener("touchmove", this.onTouchMove, { passive: false })
        window.addEventListener("resize", this.onResize)

        this.scroll.current = window.scrollY
        this.scroll.target = this.scroll.current

        if (this.options.checkOverflowHidden) {
          this.setupOverflowObserver()
          this.checkOverflowState()
        }
      }

      checkOverflowState() {
        const htmlElement = document.documentElement
        const hasOverflowHidden = htmlElement.classList.contains("overflow-hidden")

        if (hasOverflowHidden && this.isEnabled) {
          this.disableSmoothScroll()
        } else if (!hasOverflowHidden && !this.isEnabled) {
          this.enableSmoothScroll()
        }
      }

      setupOverflowObserver() {
        if ("MutationObserver" in window) {
          this.observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
              if (mutation.type === "attributes" && mutation.attributeName === "class") {
                this.checkOverflowState()
              }
            })
          })

          this.observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
          })
        }
      }

      disableSmoothScroll() {
        this.isEnabled = false

        if (this.rafId) {
          cancelAnimationFrame(this.rafId)
          this.rafId = null
        }

        this.isScrolling = false
      }

      enableSmoothScroll() {
        this.isEnabled = true
        this.scroll.current = window.scrollY
        this.scroll.target = this.scroll.current
        this.updateScrollLimit()
      }

      onWheel(e) {
        if (!this.isEnabled) return

        e.preventDefault()

        this.scroll.target += e.deltaY * this.options.wheelMultiplier
        this.scroll.target = Math.max(0, Math.min(this.scroll.target, this.scroll.limit))

        this.startAnimation()
      }

      onTouchStart(e) {
        if (!this.isEnabled) return

        this.startY = e.touches[0].clientY
        this.scrollStart = this.scroll.target
      }

      onTouchMove(e) {
        if (!this.isEnabled || !this.startY) return

        e.preventDefault()

        const y = e.touches[0].clientY
        const distance = (this.startY - y) * this.options.touchMultiplier

        this.scroll.target = this.scrollStart + distance
        this.scroll.target = Math.max(0, Math.min(this.scroll.target, this.scroll.limit))

        this.startAnimation()
      }

      onResize() {
        this.updateScrollLimit()
        this.scroll.target = Math.min(this.scroll.target, this.scroll.limit)
      }

      updateScrollLimit() {
        this.scroll.limit = document.body.scrollHeight - window.innerHeight
      }

      startAnimation() {
        if (!this.isScrolling && this.isEnabled) {
          this.isScrolling = true
          this.animate()
        }
      }

      animate() {
        if (!this.isEnabled) {
          this.isScrolling = false
          return
        }

        // Рассчитываем расстояние до цели
        const distance = Math.abs(this.scroll.target - this.scroll.current)

        // Проверяем фиксированную дистанцию остановки
        if (distance <= this.options.stopDistance) {
          this.scroll.current = this.scroll.target
          this.isScrolling = false
          window.scrollTo(0, this.scroll.current)
          return
        }

        // Применяем стандартное демпфирование
        this.scroll.current += (this.scroll.target - this.scroll.current) * this.options.damping
        window.scrollTo(0, this.scroll.current)

        this.rafId = requestAnimationFrame(this.animate)
      }

      scrollTo(target, instant = false) {
        if (!this.isEnabled) {
          if (typeof target === "number") {
            window.scrollTo(0, target)
          } else if (target instanceof Element) {
            target.scrollIntoView({ behavior: instant ? "auto" : "smooth" })
          }
          return
        }

        if (typeof target === "number") {
          this.scroll.target = Math.max(0, Math.min(target, this.scroll.limit))
        } else if (target instanceof Element) {
          const rect = target.getBoundingClientRect()
          this.scroll.target = Math.max(0, Math.min(window.scrollY + rect.top, this.scroll.limit))
        }

        if (instant) {
          this.scroll.current = this.scroll.target
          window.scrollTo(0, this.scroll.current)
        } else {
          this.startAnimation()
        }
      }

      destroy() {
        if (this.rafId) {
          cancelAnimationFrame(this.rafId)
        }

        if (this.observer) {
          this.observer.disconnect()
        }

        window.removeEventListener("wheel", this.onWheel)
        window.removeEventListener("touchstart", this.onTouchStart)
        window.removeEventListener("touchmove", this.onTouchMove)
        window.removeEventListener("resize", this.onResize)
      }

      enable() {
        this.enableSmoothScroll()
      }

      disable() {
        this.disableSmoothScroll()
      }

      isSmoothScrollEnabled() {
        return this.isEnabled
      }

      // Новый метод для изменения дистанции на лету
      setStopDistance(distance) {
        this.options.stopDistance = Math.max(0.1, distance)
      }

      // Новый метод для получения текущей дистанции
      getStopDistance() {
        return this.options.stopDistance
      }
    }

