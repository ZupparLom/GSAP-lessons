Проигрывание анимации в div.logo-transform при скроле блока .way_main.
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.querySelector('.logo-transform');
    const triggerBlock = document.querySelector('.way_main');

    // Настройки:
    const startPercent = 0.2; // начало анимации (20% прокрутки блока)
    const endPercent = 1.0;   // конец анимации (100%)

    // Плавность
    let targetFrame = 0;
    let currentFrame = 0;
    const smoothFactor = 0.1; // чем меньше, тем плавнее

    // Загружаем анимацию
    const animation = lottie.loadAnimation({
      container: container,
      renderer: 'svg',
      loop: false,
      autoplay: false,
      path: 'https://yourdomain.com/animations/logo-transform.json' // Твой путь
    });

    // Обновляем целевой кадр на скролле
    function updateTargetFrame() {
      if (!triggerBlock || !animation.isLoaded) return;

      const rect = triggerBlock.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      const blockTop = rect.top;
      const blockHeight = rect.height;

      // Расчёт % прокрутки от верха до низа блока
      const visibleStart = windowHeight - blockHeight;
      const visibleEnd = 0;

      const totalScroll = windowHeight + blockHeight;
      const scrolled = windowHeight - blockTop;

      let progress = scrolled / totalScroll;

      // Нормализуем с учётом начальной и конечной точки
      const range = endPercent - startPercent;
      let relativeProgress = (progress - startPercent) / range;

      // Ограничиваем от 0 до 1
      relativeProgress = Math.max(0, Math.min(1, relativeProgress));

      // Целевой кадр
      targetFrame = relativeProgress * animation.totalFrames;
    }

    // Анимация плавности (инерция)
    function smoothUpdate() {
      currentFrame += (targetFrame - currentFrame) * smoothFactor;
      animation.goToAndStop(currentFrame, true);
      requestAnimationFrame(smoothUpdate);
    }

    // Инициализация после загрузки
    animation.addEventListener('DOMLoaded', () => {
      // Начальная поза (0 кадр)
      animation.goToAndStop(0, true);

      // Запуск инерционного обновления
      smoothUpdate();

      // Следим за скроллом
      window.addEventListener('scroll', updateTargetFrame);
      window.addEventListener('resize', updateTargetFrame);
      updateTargetFrame(); // при загрузке
    });
  });
</script>

С возможностью задавать отдельные значения startPercent и endPercent для мобильных устройств (например, для экранов < 480px), сохранив логику для десктопа.
Где для пк класс div для Lottie .logo-transform, а для моб .logo-transform-mob
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const triggerBlock = document.querySelector('.way_main'); // Блок, от которого считаем прокрутку
    if (!triggerBlock) return;

    // === Плавность ===
    const smoothFactor = 0.8;
    let targetFrame = 0;
    let currentFrame = 0;

    let animation = null;
    let container = null;
    let updateFn = null;

    // === Отдельные настройки для моб и десктоп ===
    const config = {
      desktop: {
        selector: '.logo-transform',
        start: 0.1,
        end: 0.92,
        path: '/f/data.json'
      },
      mobile: {
        selector: '.logo-transform-mob',
        start: 0.25,
        end: 0.95,
        path: '/f/data.json' // Можно задать другой JSON при необходимости
      }
    };

    function initAnimation() {
      const isMobile = window.innerWidth < 480;
      const conf = isMobile ? config.mobile : config.desktop;

      container = document.querySelector(conf.selector);
      if (!container) return;

      // Очищаем предыдущую анимацию если есть
      if (animation) {
        animation.destroy();
        animation = null;
      }

      // Загружаем новую анимацию
      animation = lottie.loadAnimation({
        container: container,
        renderer: 'svg',
        loop: false,
        autoplay: false,
        path: conf.path
      });

      animation.addEventListener('DOMLoaded', () => {
        animation.goToAndStop(0, true);
        smoothUpdate();
        updateFn = () => updateTargetFrame(conf.start, conf.end);
        window.addEventListener('scroll', updateFn);
        updateFn(); // при загрузке
      });
    }

    function updateTargetFrame(start, end) {
      if (!animation || !animation.isLoaded) return;

      const rect = triggerBlock.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const blockHeight = rect.height;
      const blockTop = rect.top;
      const totalScroll = windowHeight + blockHeight;
      const scrolled = windowHeight - blockTop;

      let progress = scrolled / totalScroll;
      let range = end - start;
      let relativeProgress = (progress - start) / range;

      relativeProgress = Math.max(0, Math.min(1, relativeProgress));
      targetFrame = relativeProgress * animation.totalFrames;
    }

    function smoothUpdate() {
      currentFrame += (targetFrame - currentFrame) * smoothFactor;
      if (animation) animation.goToAndStop(currentFrame, true);
      requestAnimationFrame(smoothUpdate);
    }

    // Инициализация и реакция на изменение ширины
    initAnimation();
    window.addEventListener('resize', () => {
      initAnimation(); // пересоздаём анимацию на изменении ширины
    });
  });
</script>

