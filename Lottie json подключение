Когда наводишь мышку на элемент с классом .btn-white, запускается Lottie-анимация, которая находится внутри дочернего элемента .btn-dots.
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const button = document.querySelector('.btn-white'); // наведение на всю кнопку
    const dotsContainer = document.querySelectorAll('.btn-dots')[1]; // второй .btn-dots (пустой)

    if (!button || !dotsContainer) {
      console.warn('Кнопка или контейнер не найдены');
      return;
    }

    // Очищаем контейнер от лишнего
    dotsContainer.innerHTML = '';

    const anim = lottie.loadAnimation({
      container: dotsContainer,
      renderer: 'svg',
      loop: false,
      autoplay: false,
      path: '/f/knopka_animaciya.json'
    });

    // При наведении: сбрасываем на начало и запускаем снова
    button.addEventListener('mouseenter', () => {
      anim.stop();                  // Останавливаем (если вдруг еще играет)
      anim.goToAndStop(0, true);    // Перемещаемся в начало
      anim.setDirection(1);         // Направление вперёд
      anim.play();                  // Играть!
    });
  });
</script>

Можно добавлять разные элементы с разными файлами json. В данном случае тут две кнопки с разными лоти
<!-- Кнопки -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // === Кнопки .btn-white ===
    const whiteButtons = document.querySelectorAll('.btn-white');

    whiteButtons.forEach(button => {
      const dotsContainers = button.querySelectorAll('.btn-dots');
      let targetContainer = null;

      dotsContainers.forEach(container => {
        if (container.querySelector('img')) {
          targetContainer = container;
        }
      });

      if (!targetContainer) return;

      // Удаляем изображения
      targetContainer.querySelectorAll('img').forEach(img => img.remove());

      const animContainer = document.createElement('div');
      animContainer.style.width = '100%';
      animContainer.style.height = '100%';
      targetContainer.appendChild(animContainer);

      const anim = lottie.loadAnimation({
        container: animContainer,
        renderer: 'svg',
        loop: false,
        autoplay: false,
        path: '/f/knopka_animaciya.json'
      });

      button.addEventListener('mouseenter', () => {
        anim.stop();
        anim.goToAndStop(0, true);
        anim.setDirection(1);
        anim.play();
      });
    });

    // === Кнопки .btn-black ===
    const blackButtons = document.querySelectorAll('.btn-black');

    blackButtons.forEach(button => {
      const targetContainer = button.querySelector('.btn-dots_white');
      if (!targetContainer) return;

      // Удаляем изображения
      targetContainer.querySelectorAll('img').forEach(img => img.remove());

      const animContainer = document.createElement('div');
      animContainer.style.width = '100%';
      animContainer.style.height = '100%';
      targetContainer.appendChild(animContainer);

      const anim = lottie.loadAnimation({
        container: animContainer,
        renderer: 'svg',
        loop: false,
        autoplay: false,
        path: '/f/white_dots.json'
      });

      button.addEventListener('mouseenter', () => {
        anim.stop();
        anim.goToAndStop(0, true);
        anim.setDirection(1);
        anim.play();
      });
    });
  });
</script>

Универсальный подход для всех кнопок
<!-- Подключение библиотеки Lottie -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.10.2/lottie.min.js"></script>

<!-- Кнопки -->
<script>
function initLottieButtons(buttons, containerSelector) {
    buttons.forEach(button => {
        const targetContainer = button.querySelector(containerSelector);
        if (!targetContainer) return;

        // Полностью очищаем контейнер
        targetContainer.innerHTML = '';

        const animContainer = document.createElement('div');
        animContainer.style.width = '100%';
        animContainer.style.height = '100%';
        targetContainer.appendChild(animContainer);

        const anim = lottie.loadAnimation({
            container: animContainer,
            renderer: 'svg',
            loop: false,
            autoplay: false,
            path: '/f/knopka_animaciya.json'
        });

        button.addEventListener('mouseenter', () => {
            anim.stop();
            anim.goToAndStop(0, true);
            anim.setDirection(1);
            anim.play();
        });
    });
}

document.addEventListener('DOMContentLoaded', function () {
    initLottieButtons(document.querySelectorAll('.btn-white'), '.btn-dots_black');
    initLottieButtons(document.querySelectorAll('.btn-black'), '.btn-dots_white');
});
</script>
