<!-- Подключение dotLottie Player -->
<script src="https://unpkg.com/@dotlottie/player-component@latest/dist/dotlottie-player.js"></script>

<!-- Proloader -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const container = document.querySelector('.spheres');
    if (!container) return;

    container.innerHTML = '';

    const player = document.createElement('dotlottie-player');
    player.setAttribute('src', '/f/preloader.lottie');
    player.setAttribute('background', 'transparent');
    player.setAttribute('loop', 'false');
    player.style.width = '100%';
    player.style.height = '100%';

    setTimeout(() => {
      container.appendChild(player);

      player.addEventListener('ready', () => {
        player.play();
      });

      player.addEventListener('complete', () => {
        container.remove();
        console.log('done');
      });
    }, 100);
  });
</script>


Проигрывание по скроллу с GSAP ScrollTrigger
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<!-- Подключение dotLottie Player -->
<script src="https://unpkg.com/@dotlottie/player-component@latest/dist/dotlottie-player.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const container = document.querySelector('.cycle_transf');
  const triggerBlock = document.querySelector('.cycle_scroll');

  if (!container || !triggerBlock) return;

  container.innerHTML = '';

  const player = document.createElement('dotlottie-player');
  player.setAttribute('src', '/f/sphere.lottie');
  player.setAttribute('background', 'transparent');
  player.setAttribute('loop', 'false');
  player.setAttribute('autoplay', 'false');
  player.style.width = '100%';
  player.style.height = '100%';

  container.appendChild(player);

  let totalFrames = 0;
  let animationLoaded = false;

  player.addEventListener('ready', () => {
    player.pause();
  });

  player.addEventListener('frame', (e) => {
    if (!animationLoaded) {
      totalFrames = e.detail.totalFrames || 100;
      animationLoaded = true;

      // === Запускаем ScrollTrigger ===
      gsap.registerPlugin(ScrollTrigger);

      ScrollTrigger.create({
        trigger: triggerBlock,
        start: 'top 80%',         // когда верх блока попадает в 80% экрана
        end: 'bottom 20%',        // когда низ блока достигает 20% экрана
        scrub: true,              // привязка к прокрутке
        onUpdate: (self) => {
          const progress = self.progress; // от 0 до 1
          const frame = progress * totalFrames;
          player.seek(frame);
        }
      });
    }
  });
});
</script>

