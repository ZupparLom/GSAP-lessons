
<!-- Подключение GSAP и ScrollTrigger -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.10.2/lottie.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.querySelector('.cycle_transf');
    const triggerBlock = document.querySelector('.cycle_scroll');

    if (!container || !triggerBlock) return;

    // Настройки прокрутки
    const startPercent = 0.1; // старт спроигрывания
    const endPercent = 1.0; // завершение проигрывания
    const smoothFactor = 0.1;

    let targetFrame = 0;
    let currentFrame = 0;
    let animation;

    // Загрузка анимации
    animation = lottie.loadAnimation({
      container: container,
      renderer: 'canvas', // canvas = производительнее
      loop: false,
      autoplay: false,
      path: '/f/01mp4lottie_2.json'
    });

    // Плавная прокрутка кадров
    function smoothUpdate() {
      if (!animation || !animation.isLoaded) return;

      currentFrame += (targetFrame - currentFrame) * smoothFactor;
      animation.goToAndStop(currentFrame, true);
      requestAnimationFrame(smoothUpdate);
    }

    // Когда анимация загружена
    animation.addEventListener('DOMLoaded', () => {
      animation.goToAndStop(0, true);
      smoothUpdate(); // запускаем инерционную прокрутку

      // === GSAP ScrollTrigger ===
      gsap.registerPlugin(ScrollTrigger);

      ScrollTrigger.create({
        trigger: triggerBlock,
        start: 'top bottom',   // когда верх блока касается низа экрана
        end: 'bottom top',     // когда низ блока касается верха экрана
        scrub: true,           // привязка к прокрутке
        onUpdate: (self) => {
          const progress = self.progress; // 0 — 1
          const range = endPercent - startPercent;
          const relativeProgress = Math.max(0, Math.min(1, (progress - startPercent) / range));
          targetFrame = relativeProgress * animation.totalFrames;
        }
      });
    });
  });
</script>
