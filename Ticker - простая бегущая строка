Бегущая строка (с настройкой скорости) для следующей структуры:
catalog-ticker - catalog-ticker__list - catalog-ticker__item

<script>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.catalog-ticker');
    const list = container?.querySelector('.catalog-ticker__list');
    
    if (!list) {
        console.warn('Ticker not found');
        return;
    }

    // ==================== НАСТРОЙКИ ====================
    const speed = 6; // скорость движения вправо (пикселей за кадр)
    // ===================================================

    // Подготавливаем список
    list.style.display = 'flex';
    list.style.whiteSpace = 'nowrap';
    list.style.willChange = 'transform';

    // Сохраняем ТОЛЬКО элементы с содержимым
    const originals = Array.from(list.querySelectorAll('.catalog-ticker__item'))
        .filter(item => {
            // Фильтруем пустые элементы (без изображений или с нулевой шириной)
            const hasContent = item.querySelector('img') || item.textContent.trim() !== '';
            if (!hasContent) {
                console.log('Removing empty item:', item);
            }
            return hasContent;
        });

    const originalCount = originals.length;
    
    if (originalCount === 0) {
        console.warn('No valid ticker items found');
        return;
    }

    console.log('Valid items found:', originalCount);

    // Очищаем список для перестройки
    list.innerHTML = '';

    // Восстанавливаем только валидные элементы (с очисткой ID)
    originals.forEach(item => {
        const cleanItem = item.cloneNode(true);
        // Удаляем ID у клонированного элемента и его детей
        cleanItem.removeAttribute('id');
        cleanItem.querySelectorAll('[id]').forEach(child => child.removeAttribute('id'));
        
        cleanItem.style.flexShrink = '0';
        list.appendChild(cleanItem);
    });

    // Обновляем массив originals с очищенными элементами
    const currentItems = Array.from(list.querySelectorAll('.catalog-ticker__item'));
    
    // Создаем дополнительные копии для бесшовной анимации (также очищаем ID)
    for (let i = 0; i < 2; i++) {
        currentItems.forEach(item => {
            const clone = item.cloneNode(true);
            // Снова очищаем ID у клонов
            clone.removeAttribute('id');
            clone.querySelectorAll('[id]').forEach(child => child.removeAttribute('id'));
            
            clone.style.flexShrink = '0';
            list.appendChild(clone);
        });
    }

    console.log('Total items after cloning:', list.children.length);

    // Переменные состояния
    let setWidth = 0;
    let pos = 0;
    let animationFrameId = null;
    let lastWindowWidth = window.innerWidth;
    let lastWindowHeight = window.innerHeight;
    
    // Функция для точного расчета ширины одного набора
    function calculateSetWidth() {
        // Создаем временный контейнер с идентичными стилями
        const tempContainer = document.createElement('div');
        tempContainer.style.display = 'flex';
        tempContainer.style.whiteSpace = 'nowrap';
        tempContainer.style.visibility = 'hidden';
        tempContainer.style.position = 'absolute';
        tempContainer.style.left = '-9999px';
        tempContainer.style.top = '-9999px';
        
        // Копируем все relevant стили из основного списка
        const listStyles = window.getComputedStyle(list);
        tempContainer.style.gap = listStyles.gap;
        tempContainer.style.flexWrap = listStyles.flexWrap;
        tempContainer.style.alignItems = listStyles.alignItems;
        tempContainer.style.justifyContent = listStyles.justifyContent;
        
        // Добавляем один набор оригинальных элементов (из currentItems)
        currentItems.forEach(item => {
            const clone = item.cloneNode(true);
            clone.style.flexShrink = '0';
            // Убедимся, что стили копируются правильно
            clone.style.margin = window.getComputedStyle(item).margin;
            clone.style.padding = window.getComputedStyle(item).padding;
            tempContainer.appendChild(clone);
        });
        
        document.body.appendChild(tempContainer);
        
        // Даем браузеру время на отрисовку
        setTimeout(() => {
            const newSetWidth = tempContainer.scrollWidth;
            console.log('Calculated set width:', newSetWidth);
            document.body.removeChild(tempContainer);
            
            // Сохраняем пропорциональную позицию при изменении ширины
            if (setWidth > 0 && newSetWidth > 0) {
                const scaleFactor = newSetWidth / setWidth;
                pos = pos * scaleFactor;
            }

            setWidth = newSetWidth;
            
            // Для движения ВПРАВО: начинаем с левого края, чтобы элементы появлялись слева
            if (speed > 0) {
                pos = -setWidth; // Начинаем с отрицательной позиции
                console.log('Right movement: starting at position', pos);
            }
            
            // Запускаем анимацию
            if (!animationFrameId) {
                startAnimation();
            }
        }, 10);
    }

    function startAnimation() {
        // Проверяем, что ширина корректна
        if (setWidth <= 0) {
            console.error('Invalid set width calculated:', setWidth);
            return;
        }

        function animate() {
            // Движение вправо: УВЕЛИЧИВАЕМ позицию
            pos += speed;

            // Ключевое исправление для бесшовной анимации:
            // При движении вправо, когда pos достигает 0 (все элементы сдвинулись вправо),
            // нужно сбросить позицию обратно на -setWidth
            if (speed > 0 && pos >= 0) {
                pos = -setWidth;
            }
            
            // Для движения влево (если speed отрицательный)
            if (speed < 0 && pos <= -setWidth) {
                pos = 0;
            }

            list.style.transform = `translateX(${pos}px)`;
            list.style.transition = 'none';

            animationFrameId = requestAnimationFrame(animate);
        }

        // Запускаем анимацию
        animationFrameId = requestAnimationFrame(animate);
    }

    // Улучшенный обработчик ресайза
    let resizeTimeout;
    function handleResize() {
        const currentWidth = window.innerWidth;
        const currentHeight = window.innerHeight;
        
        // Определяем тип изменения размера
        const widthChanged = Math.abs(currentWidth - lastWindowWidth) > 50;
        const heightOnlyChange = Math.abs(currentWidth - lastWindowWidth) < 10 && 
                                Math.abs(currentHeight - lastWindowHeight) > 50;
        
        // Игнорируем изменения только высоты
        if (heightOnlyChange) {
            lastWindowHeight = currentHeight;
            return;
        }
        
        // Пересчитываем только при значительном изменении ширины
        if (widthChanged) {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                console.log('Significant resize detected, recalculating...');
                
                // Останавливаем текущую анимацию
                if (animationFrameId) {
                    cancelAnimationFrame(animationFrameId);
                    animationFrameId = null;
                }
                
                calculateSetWidth();
                lastWindowWidth = currentWidth;
                lastWindowHeight = currentHeight;
            }, 250);
        }
        
        lastWindowWidth = currentWidth;
        lastWindowHeight = currentHeight;
    }

    // Инициализация
    setTimeout(() => {
        lastWindowWidth = window.innerWidth;
        lastWindowHeight = window.innerHeight;
        calculateSetWidth();
        window.addEventListener('resize', handleResize);
    }, 100);

    // Функция для очистки
    window.tickerCleanup = () => {
        if (animationFrameId) {
            cancelAnimationFrame(animationFrameId);
            animationFrameId = null;
        }
        window.removeEventListener('resize', handleResize);
    };
});
</script>
