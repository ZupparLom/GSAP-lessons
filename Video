Автозагрука только на пк и планшетах
 <script>
// 📏 Определим ширину экрана при загрузке
const isMobile = window.innerWidth <= 767;

document.addEventListener("DOMContentLoaded", function () {
  // Находим все блоки с видео
  const wrappers = document.querySelectorAll(".review_video-wrap");

  wrappers.forEach(wrapper => {
    const video = wrapper.querySelector("video");
    const playBtn = wrapper.querySelector(".btn-play");

    let hasStarted = false;
    let isPlaying = false;

    // 📱 Отключаем автозагрузку видео только на мобильных
    if (isMobile) {
      // Проверим наличие источника внутри <video>
      const source = video.querySelector("source");
      if (source && !video.dataset.src) {
        // Сохраняем src в data-src и удаляем source
        video.dataset.src = source.src;
        source.remove();
        video.load(); // очищаем текущий источник
      }
    }

    // 🖥️ Hover-превью только на больших экранах
    wrapper.addEventListener("mouseenter", () => {
      if (window.innerWidth > 992 && !hasStarted) {
        video.muted = true;
        video.play();
      }
    });

    wrapper.addEventListener("mouseleave", () => {
      if (window.innerWidth > 992 && !hasStarted) {
        video.pause();
        video.currentTime = 0;
      }
    });

    // ▶️ Нажатие на кнопку воспроизведения
    playBtn.addEventListener("click", (e) => {
      e.stopPropagation();

      if (!hasStarted) {
        hasStarted = true;

        // 📱 Подгружаем видео на мобильных только при первом запуске
        if (isMobile) {
          loadVideoSrc(video);
        }

        video.pause();
        video.currentTime = 0;
        video.muted = false;
      }

      video.play();
    });

    // ⏸️ Клик по обертке — ставим видео на паузу
    wrapper.addEventListener("click", () => {
      if (hasStarted && isPlaying) {
        video.pause();
      }
    });

    // ▶️ Скрываем кнопку play при запуске
    video.addEventListener("play", () => {
      isPlaying = true;

      if (hasStarted) {
        playBtn.style.opacity = '0';

        setTimeout(() => {
          if (isPlaying) {
            playBtn.style.display = 'none';
          }
        }, 300);
      }
    });

    // ⏸️ Показываем кнопку play при паузе
    video.addEventListener("pause", () => {
      isPlaying = false;

      if (hasStarted) {
        playBtn.style.display = 'flex';
        requestAnimationFrame(() => {
          playBtn.style.opacity = '1';
        });
      }
    });
  });

  // 📦 Ленивое добавление <source> при запуске на мобилке
  function loadVideoSrc(video) {
    if (!video.src && video.dataset.src) {
      const source = document.createElement("source");
      source.src = video.dataset.src;
      source.type = "video/mp4";
      video.appendChild(source);
      video.load();
    }
  }
});
</script>
