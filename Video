скрипт для видео с наведением для превью на пк и проигрывание при нажитии на кнопку. Так же с ленивой загрузкой на моб   
  <script>
document.addEventListener("DOMContentLoaded", function () {
  // Получаем все блоки с видео
  const wrappers = document.querySelectorAll(".review_video-wrap");

  wrappers.forEach(wrapper => {
    // Элементы внутри каждого блока
    const video = wrapper.querySelector("video");           // само видео
    const playBtn = wrapper.querySelector(".btn-play");     // кнопка play

    // Логика состояния
    let hasStarted = false;  // было ли видео запущено вручную
    let isPlaying = false;   // текущее состояние (воспроизведение)

    // 🖥️ Превью при наведении — только на экранах > 992px
    wrapper.addEventListener("mouseenter", () => {
      if (window.innerWidth > 992 && !hasStarted) {
        video.muted = true;
        video.play();
      }
    });

    wrapper.addEventListener("mouseleave", () => {
      if (window.innerWidth > 992 && !hasStarted) {
        video.pause();
        video.currentTime = 0;
      }
    });

    // 👆 Клик по кнопке play
    playBtn.addEventListener("click", (e) => {
      e.stopPropagation(); // предотвращаем "всплытие" до wrapper

      // Если видео ещё не запускали вручную:
      if (!hasStarted) {
        hasStarted = true;

        // 📱 На мобильных — подгружаем видео только при первом нажатии
        if (window.innerWidth <= 992) {
          loadVideoSrc(video);
        }

        // Сброс видео на начало и включение звука
        video.pause();
        video.currentTime = 0;
        video.muted = false;
      }

      video.play();
    });

    // ✋ Клик по обёртке (не по кнопке) — ставим на паузу
    wrapper.addEventListener("click", () => {
      if (hasStarted && isPlaying) {
        video.pause();
      }
    });

    // ▶️ Когда видео запускается
    video.addEventListener("play", () => {
      isPlaying = true;

      if (hasStarted) {
        // Сначала скрываем по opacity
        playBtn.style.opacity = '0';

        // Потом убираем из потока через display
        setTimeout(() => {
          if (isPlaying) {
            playBtn.style.display = 'none';
          }
        }, 300); // столько же, сколько transition в CSS
      }
    });

    // ⏸️ Когда видео ставится на паузу
    video.addEventListener("pause", () => {
      isPlaying = false;

      if (hasStarted) {
        // Снова отображаем кнопку
        playBtn.style.display = 'flex';

        // На следующий кадр делаем её видимой
        requestAnimationFrame(() => {
          playBtn.style.opacity = '1';
        });
      }
    });
  });

  // 💡 Функция для ленивой подгрузки видео на мобилках
  function loadVideoSrc(video) {
    if (!video.src && video.dataset.src) {
      const source = document.createElement("source");
      source.src = video.dataset.src;
      source.type = "video/mp4";
      video.appendChild(source);
      video.load();
    }
  }
});
</script>

