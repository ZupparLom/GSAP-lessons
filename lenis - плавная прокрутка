Более длиная версия 
<!-- Подключаем Lenis только на экранах шире 992px -->
<script>
(function() {
  const isDesktop = () => window.innerWidth > 992;
  let lenis = null;

  // Инициализация Lenis
  function initLenis() {
    if (lenis || !isDesktop()) return;

    // Динамически подключаем библиотеку
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/lenis@1.1.13/dist/lenis.min.js';
    script.onload = () => {
      lenis = new Lenis({
        lerp: 0.08,
        smoothWheel: true,
        smoothTouch: false,
        infinite: false
      });

      function raf(time) {
        if (lenis) lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    };
    document.head.appendChild(script);
  }

  // Удаление Lenis при смене разрешения
  function destroyLenis() {
    if (lenis) {
      lenis.destroy();
      lenis = null;
    }
  }

  // Инициализация при загрузке
  document.addEventListener('DOMContentLoaded', initLenis);

  // Повторная инициализация при resize
  window.addEventListener('resize', () => {
    if (isDesktop()) {
      if (!lenis) initLenis();
    } else {
      destroyLenis();
    }
  });

  // 💡 Поддержка динамических сцен (например, в Taptop)
  const observer = new MutationObserver(() => {
    if (isDesktop() && !lenis) initLenis();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
})();
</script>




