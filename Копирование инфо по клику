Копирование содержания элемента copy-mail при клике на него. 
<script>
  // Функция копирования с fallback (без изменений)
function copyToClipboard(text) {
    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function() {
            console.log('Скопировано через Clipboard API');
        }).catch(function(err) {
            console.error('Ошибка Clipboard API: ', err);
            fallbackCopyTextToClipboard(text);
        });
    } else {
        fallbackCopyTextToClipboard(text);
    }
}

function fallbackCopyTextToClipboard(text) {
    const textArea = document.createElement('textarea');
    textArea.value = text;
    textArea.style.top = '0';
    textArea.style.left = '0';
    textArea.style.position = 'fixed';
    textArea.style.opacity = '0';
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    try {
        document.execCommand('copy');
        console.log('Скопировано через execCommand');
    } catch (err) {
        console.error('Fallback ошибка: ', err);
    }
    document.body.removeChild(textArea);
}

// Делегированный обработчик клика по .copy-mail
document.addEventListener('click', function(event) {
    // Проверяем клик именно по .copy-mail или его дочерним (span)
    if (event.target.closest('.copy-mail')) {
        // Блокируем переход по ссылке
        event.preventDefault();
        event.stopPropagation();
        
        // Получаем текст из span внутри .copy-mail
        const copyElement = event.target.closest('.copy-mail');
        const text = copyElement.querySelector('.text-block-wrap-div').textContent.trim();
        
        // Копируем
        copyToClipboard(text);
        
        // Визуальная обратная связь на .copy-mail
        copyElement.classList.add('copied');
        setTimeout(() => copyElement.classList.remove('copied'), 1500);
    }
});

</script>

