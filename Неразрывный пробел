Выбираем нужный нам текст → Добавляем ему class: no-break



<!--Добавление неразрывного пробела-->

<script>
document.addEventListener("DOMContentLoaded", function () {
    // ==========================================
    // НАСТРОЙКИ СКРИПТА
    // ==========================================
  /* Класс элементов для обработки */
  const TARGET_SELECTOR = ".no-break";

  /* Список слов, после которых нужен неразрывный пробел */
  const NBSP_WORDS = [
    "в", "где", "без", "до", "из", "к", "на", "по", "о", "от",
    "перед", "при", "через", "с", "у", "за", "над", "об", "под", "про",
    "и", "а", "но", "да", "или", "либо", "то", "ни", "не", "же", "как"
  ];
    // ==========================================
    
  /* HTML-сущность неразрывного пробела */
  const NBSP_ENTITY = "&nbsp;";

  /* Регулярное выражение:
     (?![^<]*>) - защита от замены внутри HTML-атрибутов
     (^|\\s|&nbsp;|>) - перед словом начало строки, пробел, неразрывный пробел или конец тега
     \\s+ - после слова один или несколько пробелов */
  const REPLACE_REGEXP = new RegExp(
    `(?![^<]*>)(^|\\s|&nbsp;|>)(${NBSP_WORDS.join("|")})\\s+`,
    "gi"
  );

  /* Добавление неразрывных пробелов */
  function replaceShortWords(text) {
    let currentText = text;
    let previousText = "";

    while (currentText !== previousText) {
      previousText = currentText;
      currentText = currentText.replace(
        REPLACE_REGEXP,
        `$1$2${NBSP_ENTITY}`
      );
    }

    return currentText;
  }

  /* Обработка всех нужных элементов */
  function processElements() {
    const elements = document.querySelectorAll(TARGET_SELECTOR);

    elements.forEach(function (element) {
      element.innerHTML = replaceShortWords(element.innerHTML);
    });
  }

  processElements();
});
</script>
