Выбираем нужный нам текст → Добавляем ему class: no-break-prepositions

Идем в настройки проекта → Пользовательский код → Перед тегом </body>
Добавляем код:

<!--Добавление неразрывного пробела-->

Вариант 1

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Список предлогов / союзов / частиц
    const prepositions = [
      "в", "без", "до", "из", "к", "по", "о", "от", "перед", "при", "через", "с",
      "у", "за", "над", "об", "под", "про", "на",
      "и", "а", "но", "да", "или", "либо", "то", "ни", "не", "же", "как"
    ];

    // Регэксп: начало строки или пробел + (одно из слов) + пробел(ы) + дальше что-то не-пробельное
    const regex = new RegExp(`(^|\\s)(${prepositions.join("|")})(\\s+)(?=\\S)`, "gi");

    // Обработка одного текстового узла
    function processTextNode(node) {
      const original = node.nodeValue;
      const updated = original.replace(regex, function (match, before, word, spaces) {
        // делаем: " в дом" → " в дом" (обычный пробел перед, неразрывный после короткого слова)
        return before + word + "\u00A0";
      });

      if (updated !== original) {
        node.nodeValue = updated;
      }
    }

    // Рекурсивный обход DOM внутри элемента
    function walk(node) {
      // Текстовый узел
      if (node.nodeType === Node.TEXT_NODE) {
        processTextNode(node);
        return;
      }

      // Не лезем в скрипты/стили
      if (node.nodeType === Node.ELEMENT_NODE) {
        const tag = node.tagName;
        if (tag === "SCRIPT" || tag === "STYLE" || tag === "NOSCRIPT") return;
      } else {
        return;
      }

      // Обрабатываем детей
      node.childNodes.forEach(walk);
    }

    // Обрабатываем все элементы с нужным классом
    document.querySelectorAll(".no-break-prepositions").forEach(function (el) {
      walk(el);
    });
  });
</script>



Вариант2
<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Функция для добавления неразрывных пробелов
    function replacePrepositions(text) {
      // Список предлогов, которые нужно обработать
      const prepositions = ["в", "без", "до", "из", "к", "на", "по", "о", "от", "перед", "при", "через", "с", "у", "за", "над", "об", "под", "про", "и", "а", "но", "да", "или", "либо", "то", "ни", "не", "же", "как"];

      // Регулярное выражение для поиска предлогов
      const regex = new RegExp(`\\s(${prepositions.join("|")})\\s`, "gi");

      // Заменяем пробелы на неразрывные пробелы
      return text.replace(regex, " $1&nbsp;");
    }

    // Функция для обработки текста в элементах с определенным классом
    function processElements() {
      // Выбираем все элементы с классом "no-break-prepositions"
      const elements = document.querySelectorAll(".no-break-prepositions");

      elements.forEach(function(element) {
        // Обрабатываем текст в каждом элементе
        element.innerHTML = replacePrepositions(element.innerHTML);
      });
    }

    // Запускаем обработку текста
    processElements();
  });
</script>
