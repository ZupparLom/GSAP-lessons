Выбираем нужный нам текст → Добавляем ему class: no-break



<!--Добавление неразрывного пробела-->

<script>
 document.addEventListener("DOMContentLoaded", function() {
  // Функция для добавления неразрывных пробелов
  function replacePrepositions(text) {
    // Список предлогов, которые нужно обработать
    const prepositions = ["в", "где", "без", "до", "из", "к", "на", "по", "о", "от", "перед", "при", "через", "с", "у", "за", "над", "об", "под", "про", "и", "а", "но", "да", "или", "либо", "то", "ни", "не", "же", "как"];

    // Регулярное выражение:
    // (?![^<]*>) - защита от замены пробелов внутри HTML-атрибутов тегов
    // (^|\\s|&nbsp;|>) - перед предлогом может быть начало строки, пробел, неразрывный пробел или конец тега
    // \\s+ - после предлога идет один или несколько пробелов
    const regex = new RegExp(`(?![^<]*>)(^|\\s|&nbsp;|>)(${prepositions.join("|")})\\s+`, "gi");

    let currentText = text;
    let previousText = "";

    // Цикл решает проблему предлогов, идущих подряд.
    // Прогоняем замену до тех пор, пока текст не перестанет меняться.
    while (currentText !== previousText) {
      previousText = currentText;
      // Заменяем совпадение, сохраняя левую границу ($1) и сам предлог ($2), добавляя неразрывный пробел
      currentText = currentText.replace(regex, "$1$2&nbsp;");
    }

    return currentText;
  }

  // Функция для обработки текста в элементах с определенным классом
  function processElements() {
    // Выбираем все элементы с классом "no-break"
    const elements = document.querySelectorAll(".no-break");

    elements.forEach(function(element) {
      // Обрабатываем текст в каждом элементе
      element.innerHTML = replacePrepositions(element.innerHTML);
    });
  }

  // Запускаем обработку текста
  processElements();
});
</script>
